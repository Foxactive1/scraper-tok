{
  "$schema": "https://railway.com/railway.schema.json",

  "build": {
    "builder": "NIXPACKS"
  },

  "deploy": {
    "startCommand": "gunicorn 'app:create_app()' --bind 0.0.0.0:$PORT --workers 2 --timeout 60 --access-logfile -",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },

  "environments": {
    "production": {
      "deploy": {
        "startCommand": "gunicorn 'app:create_app()' --bind 0.0.0.0:$PORT --workers 2 --timeout 60 --access-logfile -",
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
      }
    }
  }
}
