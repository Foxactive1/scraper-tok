{
  "$schema": "https://railway.com/railway.schema.json",

  "build": {
    "builder": "NIXPACKS"
  },

  "deploy": {
    "startCommand": "python run.py",
    "healthcheckPath": "/",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  },

  "environments": {
    "production": {
      "deploy": {
        "startCommand": "python run.py",
        "numReplicas": 1,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 5
      }
    }
  }
}
